# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
# In production, set these in Vercel → Settings → Environment Variables.

# --- iPaymu (payment gateway) ---
# Sandbox creds: sandbox.ipaymu.com/integration | Production: my.ipaymu.com/integration
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_MODE=sandbox            # "sandbox" while testing, "production" when live

# --- License signing (no database) ---
# Long random strings. Generate e.g. with: openssl rand -hex 32
LICENSE_SECRET=                # HMAC secret for signing license tokens & referenceId
OWNER_LICENSE_KEY=             # your private owner key — paste it in-app to access free

# --- Email delivery of license key (Resend) ---
RESEND_API_KEY=                # from resend.com
LICENSE_FROM_EMAIL=            # e.g. noreply@bananacarousel.click (verify domain in Resend)

# --- App URL (used to build returnUrl / notifyUrl) ---
NEXT_PUBLIC_APP_URL=https://www.bananacarousel.click

# --- Tidio live chat widget (public key from //code.tidio.co/KEY.js) ---
NEXT_PUBLIC_TIDIO_PUBLIC_KEY=

# --- Supabase (accounts, database, storage) ---
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server-only — bypasses RLS, NEVER expose to client
OWNER_EMAIL=                   # super-admin email(s), comma-separated — auto-promoted to admin

# --- Telegram admin notifications (bot @NusaNotif_bot) ---
TELEGRAM_BOT_TOKEN=            # server-only — from @BotFather
TELEGRAM_ADMIN_CHAT_ID=        # chat id to notify (get via getUpdates)

# --- Manual bank transfer (shown to buyers; not secret) ---
NEXT_PUBLIC_ADMIN_WHATSAPP=    # digits only, intl format e.g. 62812xxxxxxx
NEXT_PUBLIC_BANK_NAME=Bank Jago Syariah
NEXT_PUBLIC_BANK_ACCOUNT_NO=501697030764
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Husna Muthmainnah

# --- Dashboard tutorial (optional) ---
NEXT_PUBLIC_TUTORIAL_YOUTUBE_ID=   # YouTube video id only (empty = placeholder)

# --- Cron (history cleanup) ---
CRON_SECRET=                   # secret for daily Vercel Cron; openssl rand -hex 24

# === V2 AI GATEWAY (BYOK multi-provider) ======================================
# Encryption secret for users' provider keys at rest (AES-256-GCM).
# MUST be set in production. Generate with: openssl rand -hex 32
AI_KEYS_ENC_SECRET=

# Feature flag: route generation through the server gateway (multi-provider,
# rotation, cache, monitoring). "on" = new path, anything else = legacy
# client-side Gemini path (instant rollback). Default off until smoke-tested.
NEXT_PUBLIC_USE_GATEWAY=off

# --- Upstash Redis (cache, rate-limit, key-health) ---
# From console.upstash.com (Redis, not QStash). If you create it via
# Vercel → Storage → "Upstash for Redis", Vercel auto-injects KV_REST_API_URL /
# KV_REST_API_TOKEN instead — the code reads either naming.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Alternative names auto-set by the Vercel Storage integration:)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# === V2 ANALYTICS & ADS (all optional — dormant until an id is set) ==========
# Each integration only loads if its id below is non-empty. Safe to leave blank.
NEXT_PUBLIC_GTM_ID=            # Google Tag Manager container, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GA4_ID=            # GA4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=     # Meta (Facebook) Pixel id
NEXT_PUBLIC_TIKTOK_PIXEL_ID=   # TikTok Pixel id
NEXT_PUBLIC_CLARITY_ID=        # Microsoft Clarity project id
NEXT_PUBLIC_POSTHOG_KEY=       # PostHog project API key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GOOGLE_ADS_ID=     # Google Ads conversion id, e.g. AW-XXXXXXXXX

# Server-side conversion relays (optional — for CAPI / Events API / GA4 MP)
META_CAPI_TOKEN=               # Meta Conversions API access token
TIKTOK_EVENTS_TOKEN=           # TikTok Events API access token
GA4_API_SECRET=                # GA4 Measurement Protocol api_secret

# --- Error tracking (optional) ---
SENTRY_DSN=                    # from sentry.io; empty = disabled
NEXT_PUBLIC_SENTRY_DSN=
