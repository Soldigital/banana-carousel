# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
# In production, set these in Vercel → Settings → Environment Variables.

# --- iPaymu (payment gateway) ---
# Sandbox creds: sandbox.ipaymu.com/integration | Production: my.ipaymu.com/integration
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_MODE=sandbox            # "sandbox" while testing, "production" when live

# --- License signing (no database) ---
# Long random strings. Generate e.g. with: openssl rand -hex 32
LICENSE_SECRET=                # HMAC secret for signing license tokens & referenceId
OWNER_LICENSE_KEY=             # your private owner key — paste it in-app to access free

# --- Email delivery of license key (Resend) ---
RESEND_API_KEY=                # from resend.com
LICENSE_FROM_EMAIL=            # e.g. noreply@bananacarousel.click (verify domain in Resend)

# --- App URL (used to build returnUrl / notifyUrl) ---
NEXT_PUBLIC_APP_URL=https://www.bananacarousel.click

# --- Tidio live chat widget (public key from //code.tidio.co/KEY.js) ---
NEXT_PUBLIC_TIDIO_PUBLIC_KEY=

# --- Supabase (accounts, database, storage) ---
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server-only — bypasses RLS, NEVER expose to client
OWNER_EMAIL=                   # your email — auto-promoted to admin on login

# --- Telegram admin notifications (bot @NusaNotif_bot) ---
TELEGRAM_BOT_TOKEN=            # server-only — from @BotFather
TELEGRAM_ADMIN_CHAT_ID=        # chat id to notify (get via getUpdates)

# --- Manual bank transfer (shown to buyers; not secret) ---
NEXT_PUBLIC_ADMIN_WHATSAPP=    # digits only, intl format e.g. 62812xxxxxxx
NEXT_PUBLIC_BANK_NAME=Bank Jago Syariah
NEXT_PUBLIC_BANK_ACCOUNT_NO=501697030764
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Husna Muthmainnah
